NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Used in calendar invites and share links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only (never prefix with NEXT_PUBLIC_). Supabase → Project Settings → API Keys → secret/service_role.
# Lets the server look up a leader's email to notify them about new people.
SUPABASE_SERVICE_ROLE_KEY=
# Resend (resend.com) for leader notifications, sending from the verified findabiblestudy.org domain.
# (With the default onboarding@resend.dev sender, Resend only delivers to your own account email.)
RESEND_API_KEY=
EMAIL_FROM="Find a Bible Study <hello@findabiblestudy.org>"
